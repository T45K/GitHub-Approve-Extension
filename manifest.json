{
    "manifest_version": 3,
    "name": "GitHub PR Approve Button",
    "version": "1.0",
    "description": "Add an approve button directly on the PR top page.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://github.com/*",
        "https://5lfj3yztuyxeydyhgujokykcpe0gnzsa.lambda-url.ap-northeast-1.on.aws/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://github.com/*/*/pull/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
